generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cafe {
  id        String      @id @default(uuid())
  name      String
  description String?
  type      String?     // restaurant, cafe, etc.
  city      String?
  district  String?
  address   String?
  phone     String?
  email     String?     // Contact email
  website   String?
  
  // Authorized Person Info
  authorizedPerson String? @map("authorized_person")

  // Operational Info
  serviceType     String? @map("service_type") // table, package, both
  workingHours    String? @map("working_hours")
  preparationTime Int?    @map("preparation_time") // in minutes
  paymentMethods  String? @map("payment_methods") // JSON string or comma separated
  logoUrl         String? @map("logo_url")
  coverImageUrl     String?   @map("cover_image_url")
  brandColor        String?   @default("#000000") @map("brand_color")
  menuViewMode      String?   @default("card") @map("menu_view_mode") // "card" | "list"
  welcomeMessage    String?   @map("welcome_message")
  
  // Social & Wifi
  instagramUrl      String?   @map("instagram_url")
  facebookUrl       String?   @map("facebook_url")
  twitterUrl        String?   @map("twitter_url")
  wifiSsid          String?   @map("wifi_ssid")
  wifiPassword      String?   @map("wifi_password")
  
  // Service Config
  waiterCallOptions String?   @map("waiter_call_options") // JSON string: ["bill", "waiter", "cleanup", "ashtray"]
  isMaintenanceMode Boolean   @default(false) @map("is_maintenance_mode")

  googleMapsUrl   String? @map("google_maps_url")

  isActive  Boolean     @default(true) @map("is_active")
  status    String      @default("PENDING") // PENDING, APPROVED, REJECTED
  showProductRatings Boolean @default(true) @map("show_product_ratings")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  admins    CafeAdmin[]
  categories Category[]
  products  Product[]
  tables    Table[]
  orders    Order[]
  waiterCalls WaiterCall[]

  @@map("cafes")
}

model WaiterCall {
  id        String   @id @default(uuid())
  cafeId    String   @map("cafe_id")
  tableId   String   @map("table_id")
  type      String?  @default("Garson")
  status    String   @default("PENDING") // PENDING, COMPLETED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("waiter_calls")
}

model CafeAdmin {
  id           String   @id @default(uuid())
  cafeId       String   @map("cafe_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  isApproved   Boolean  @default(false) @map("is_approved")
  resetCode    String?  @map("reset_code")
  resetCodeExpires DateTime? @map("reset_code_expires")
  
  // Security
  twoFactorSecret String? @map("two_factor_secret")
  isTwoFactorEnabled Boolean @default(false) @map("is_two_factor_enabled")
  
  sessions     AdminSession[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cafe         Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@map("cafe_admins")
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  token     String   @unique // Store the JWT or a hash of it to identify/revoke
  device    String?  // User-Agent info (e.g., "Chrome on Windows")
  ip        String?
  lastActive DateTime @default(now()) @map("last_active")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  admin     CafeAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("super_admins")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Category {
  id        String    @id @default(uuid())
  cafeId    String    @map("cafe_id")
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  cafe      Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  cafeId      String      @map("cafe_id")
  categoryId  String      @map("category_id")
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  originalPrice Decimal?  @map("original_price") @db.Decimal(10, 2)
  stock       Int         @default(0)
  sortOrder   Int         @default(0) @map("sort_order")
  imageUrl    String?     @map("image_url")
  isAvailable Boolean     @default(true) @map("is_available")
  isChefRecommended Boolean @default(false) @map("is_chef_recommended")
  averageRating Decimal   @default(0) @db.Decimal(3, 2) @map("average_rating")
  reviewCount   Int       @default(0) @map("review_count")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  cafe        Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  reviews     Review[]

  @@map("products")
}

model Table {
  id          String   @id @default(uuid())
  cafeId      String   @map("cafe_id")
  tableNumber Int      @map("table_number")
  isOccupied  Boolean  @default(false) @map("is_occupied")
  lastOccupiedAt DateTime? @map("last_occupied_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  orders      Order[]
  waiterCalls WaiterCall[]

  @@unique([cafeId, tableNumber])
  @@map("tables")
}

model Order {
  id           String      @id @default(uuid())
  cafeId       String      @map("cafe_id")
  tableId      String?     @map("table_id")
  customerName String?     @map("customer_name")
  status       String      @default("pending") // pending, preparing, delivered
  totalAmount  Decimal     @default(0) @db.Decimal(10, 2) @map("total_amount")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  cafe         Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  table        Table?      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  payment      Payment?

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2) @map("unit_price")
  totalPrice Decimal  @db.Decimal(10, 2) @map("total_price")
  createdAt  DateTime @default(now()) @map("created_at")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique @map("order_id")
  amount        Decimal  @db.Decimal(10, 2)
  status        String   @default("pending") // pending, completed, failed
  receiptNumber String?  @map("receipt_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  orderId     String?  @map("order_id")
  customerName String? @map("customer_name")
  rating      Int
  comment     String?
  adminScore  Int?     @map("admin_score")
  adminReply  String?  @map("admin_reply")
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
