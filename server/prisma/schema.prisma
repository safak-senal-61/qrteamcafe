generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cafe {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique // EKLENDİ
  description String?
  type      String?     // restaurant, cafe, etc.
  city      String?
  district  String?
  address   String?
  phone     String?
  email     String?     // Contact email
  website   String?
  
  // Authorized Person Info
  authorizedPerson String? @map("authorized_person")

  // Operational Info
  serviceType     String? @map("service_type") // table, package, both
  workingHours    String? @map("working_hours")
  preparationTime Int?    @map("preparation_time") // in minutes
  paymentMethods  String? @map("payment_methods") // JSON string or comma separated
  logoUrl         String? @map("logo_url")
  coverImageUrl     String?   @map("cover_image_url")
  brandColor        String?   @default("#000000") @map("brand_color")
  menuViewMode      String?   @default("card") @map("menu_view_mode") // "card" | "list"
  welcomeMessage    String?   @map("welcome_message")
  
  // Social & Wifi
  instagramUrl      String?   @map("instagram_url")
  facebookUrl       String?   @map("facebook_url")
  twitterUrl        String?   @map("twitter_url")
  wifiSsid          String?   @map("wifi_ssid")
  wifiPassword      String?   @map("wifi_password")
  
  // Service Config
  waiterCallOptions String?   @map("waiter_call_options") // JSON string: ["bill", "waiter", "cleanup", "ashtray"]
  isMaintenanceMode Boolean   @default(false) @map("is_maintenance_mode")

  googleMapsUrl   String? @map("google_maps_url")

  isActive  Boolean     @default(true) @map("is_active")
  status    String      @default("PENDING") // PENDING, APPROVED, REJECTED
  showProductRatings Boolean @default(true) @map("show_product_ratings")
  autoApproveReviews Boolean @default(false) @map("auto_approve_reviews")
  isSoundEnabled     Boolean @default(true) @map("is_sound_enabled")
  
  // Theme & Template
  templateId      String?   @default("classic") @map("template_id")
  themeConfig     String?   @map("theme_config") // JSON string for advanced customization

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  admins    CafeAdmin[]
  categories Category[]
  products  Product[]
  tables    Table[]
  orders    Order[]
  waiterCalls WaiterCall[]
  rewards     Reward[]

  @@map("cafes")
}

model WaiterCall {
  id        String   @id @default(uuid())
  cafeId    String   @map("cafe_id")
  tableId   String   @map("table_id")
  type      String?  @default("Garson")
  status    String   @default("PENDING") // PENDING, COMPLETED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("waiter_calls")
}

model CafeAdmin {
  id           String   @id @default(uuid())
  cafeId       String   @map("cafe_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  isApproved   Boolean  @default(false) @map("is_approved")
  resetCode    String?  @map("reset_code")
  resetCodeExpires DateTime? @map("reset_code_expires")
  
  // Security
  twoFactorSecret String? @map("two_factor_secret")
  isTwoFactorEnabled Boolean @default(false) @map("is_two_factor_enabled")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  sessions  AdminSession[]

  @@map("cafe_admins")
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  token     String   @unique // JWT token signature or a random session ID
  device    String?  // User Agent or device info
  ip        String?
  lastActive DateTime @default(now()) @map("last_active")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  admin     CafeAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("super_admins")
}

// System Settings for Super Admin
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  description String?
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Category {
  id        String   @id @default(uuid())
  cafeId    String   @map("cafe_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe     Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  cafeId      String   @map("cafe_id")
  categoryId  String   @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2) @map("original_price") // For discounts
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  preparationTime Int? @map("preparation_time") // minutes
  sortOrder   Int      @default(0) @map("sort_order")
  
  // New Features
  isChefRecommended Boolean @default(false) @map("is_chef_recommended")
  requiresPreparation Boolean @default(true) @map("requires_preparation")
  stock       Int?      @default(9999) // Simple stock management
  
  averageRating Decimal? @default(0) @db.Decimal(3, 2) @map("average_rating")
  reviewCount   Int      @default(0) @map("review_count")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafe     Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  reviews    Review[]

  @@map("products")
}

model Table {
  id          String   @id @default(uuid())
  cafeId      String   @map("cafe_id")
  tableNumber Int      @map("table_number")
  qrCode      String?  @map("qr_code") // URL or Base64
  capacity    Int?
  isOccupied  Boolean  @default(false) @map("is_occupied")
  lastOccupiedAt DateTime? @map("last_occupied_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafe     Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  orders   Order[]
  waiterCalls WaiterCall[]

  @@unique([cafeId, tableNumber])
  @@map("tables")
}

model Customer {
  id           String   @id @default(uuid())
  name         String?
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  isVerified   Boolean  @default(false) @map("is_verified")
  
  // Verification
  verificationCode String? @map("verification_code")
  verificationCodeExpires DateTime? @map("verification_code_expires")
  
  // Password Reset
  resetCode String? @map("reset_code")
  resetCodeExpires DateTime? @map("reset_code_expires")

  // Email Change Verification
  tempEmail String? @map("temp_email")

  loyaltyPoints Int      @default(0) @map("loyalty_points")
  referralCode  String?  @unique @map("referral_code")
  referredById  String?  @map("referred_by_id")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders       Order[]
  reviews      Review[]
  loyaltyTransactions LoyaltyTransaction[]
  
  referredBy   Customer?  @relation("CustomerReferrals", fields: [referredById], references: [id])
  referrals    Customer[] @relation("CustomerReferrals")

  @@map("customers")
}

model Order {
  id          String   @id @default(uuid())
  cafeId      String   @map("cafe_id")
  tableId     String?  @map("table_id") // Optional for takeaway
  customerId  String?  @map("customer_id") // Optional for guest
  
  status      String   @default("PENDING") // PENDING, PREPARING, READY, DELIVERED, COMPLETED, CANCELLED
  paymentStatus String @default("PENDING") // PENDING, PAID, REFUNDED
  paymentMethod String? @map("payment_method") // CASH, CREDIT_CARD
  
  totalAmount Decimal  @db.Decimal(10, 2) @map("total_amount")
  note        String?
  
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafe     Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  table    Table?    @relation(fields: [tableId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  reviews  Review[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2) @map("unit_price")
  totalPrice Decimal @db.Decimal(10, 2) @map("total_price")
  options   String?  // JSON string for selected options
  note      String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id        String   @id @default(uuid())
  cafeId    String   @map("cafe_id") 
  productId String?  @map("product_id")
  customerId String? @map("customer_id")
  orderId   String?  @map("order_id")
  
  rating    Int      // 1-5
  comment   String?
  customerName String? @map("customer_name")
  
  isVisible  Boolean @default(true) @map("is_visible")
  isApproved Boolean @default(false) @map("is_approved") // Admin moderation
  
  adminReply String? @map("admin_reply")
  adminScore Int?    @map("admin_score") // Admin internal score for customer

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  @@map("reviews")
}

model Reward {
  id          String   @id @default(uuid())
  cafeId      String   @map("cafe_id")
  title       String
  description String?
  pointsCost  Int      @map("points_cost")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@map("rewards")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  amount      Int
  type        String   // EARNED_ORDER, SPENT_REWARD, REFUND, BONUS
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("loyalty_transactions")
}
